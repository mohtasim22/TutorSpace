# Origin the browser loads the app from. Must match what you actually type in
# the address bar — the Better Auth session cookie is scoped to this origin,
# so a localhost/127.0.0.1 mismatch here silently breaks login.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Origin of the Express API (no path). Used by server-side code — Server
# Components, Server Actions and middleware — to call the API directly instead
# of going back through this app's own /api/v1 rewrite. See src/lib/api.ts.
#
# Prefer 127.0.0.1 over localhost locally: on Windows, localhost resolves to
# IPv6 ::1 first and stalls if Express is bound to IPv4 only.
API_BASE="http://127.0.0.1:5000"

# Cloudinary — used for direct browser uploads of assignment submissions and
# course materials. The preset must be an UNSIGNED upload preset.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your_unsigned_upload_preset"
