BETTER_AUTH_SECRET="your_better_auth_secret_key"

DATABASE_URL="your_postgresql_connection_string"

FRONTEND_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:5000"

STRIPE_SECRET_KEY="your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="your_stripe_webhook_secret"
# Currency Stripe Checkout charges in. Defaults to "bdt" when unset.
STRIPE_CURRENCY="bdt"

# Daily.co — the managed SFU behind the live video call. Without this key the
# video endpoint returns "Video is not configured" and no call can start.
# Get one from https://dashboard.daily.co/developers
DAILY_API_KEY="your_daily_api_key"

# Note: the collaborative whiteboard needs no key of its own, but it does use
# BETTER_AUTH_SECRET above to derive its unguessable room ids. Changing that
# secret changes every room id, so a board in progress would be orphaned.

# Anthropic (Claude) - powers the AI features: practice-question generation
# from course materials, and the review summaries on tutor profiles. Without
# it those endpoints return "AI features are not configured" and everything
# else keeps working. Get a key from https://console.anthropic.com
# Server-side only - never expose this to the browser.
ANTHROPIC_API_KEY="your_anthropic_api_key"

# SMTP Configuration
SMTP_USER="your_smtp_email@example.com"
SMTP_PASS="your_smtp_app_password"
EMAIL_FROM="Your App Name <your_smtp_email@example.com>"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
